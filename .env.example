# ─── Supabase ──────────────────────────────────────────────
# Lấy ở: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — CHỈ dùng ở server (route handlers). KHÔNG để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI / Translate ───────────────────────────────────────
# Provider dịch chính: "gemini" | "openai" | "mymemory" | "libretranslate".
# ĐỂ TRỐNG = tự dò: có GEMINI_API_KEY → gemini, có OPENAI_API_KEY → openai,
# không có key nào → mymemory. Khuyến nghị: gemini (free tier, dịch tự nhiên hơn).
AI_PROVIDER=
# Provider DỰ PHÒNG khi provider chính lỗi/hết quota (mặc định mymemory; "off" để tắt).
# Nhờ nó, hết quota chỉ làm chất lượng dịch giảm chứ không làm hỏng việc tạo thẻ.
AI_FALLBACK=mymemory

# Gemini: dòng Flash có free tier — lấy key ở https://aistudio.google.com/apikey
# Hạn mức free theo phút/ngày khá chặt (xem AI Studio → Rate limits), nên AI_FALLBACK
# ở trên không phải trang trí: tra nhanh vài từ liên tiếp là chạm trần RPM.
# LƯU Ý: Google khai tử model theo thời gian (gemini-2.0-flash đã shut down,
# gemini-1.5-flash không còn trong tài liệu) — kiểm tra tên model còn sống trước khi ghim.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI: KHÔNG có free tier — chỉ điền nếu bạn chấp nhận trả tiền.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# MyMemory: free, KHÔNG cần key. Thêm email hợp lệ để tăng quota ~5k→50k từ/ngày.
MYMEMORY_EMAIL=
# LibreTranslate: self-host (docker) thì để localhost; instance công khai cần api_key
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# ─── App ──────────────────────────────────────────────────
# Dùng cho redirect OAuth (dev: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
