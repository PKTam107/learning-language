{
  "expo": {
    "name": "LinguaCards",
    "slug": "linguacards",
    "scheme": "linguacards",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef2ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linguacards.app"
    },
    "android": {
      "package": "com.linguacards.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#eef2ff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Cho phép LinguaCards dùng micro để thu âm luyện nói khi bạn bấm Thu giọng mình."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "dabb5158-df23-4a19-b3dd-930ba9c0a8bd"
      }
    },
    "owner": "tampk1107"
  }
}
